{
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash(python3 -m unittest:*)",
      "Bash(python3 -m toc:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(ls:*)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false
  }
}
